# Esempio: NON inserire qui credenziali reali. Copia in .env per l'uso locale.
GEMINI_API_KEY=inserisci_la_tua_chiave_solo_in_locale
GEMINI_MODEL=gemini-3.1-flash-lite
TAVILY_API_KEY=inserisci_la_tua_chiave_solo_in_locale

# Account individuali + archivio permanente (consigliato)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=chiave_anon_o_publishable
# Facoltativa: indirizzo pubblico dell'app (es. https://salespilot.onrender.com)
APP_URL=

# Informativa privacy: titolare e email di contatto per le richieste GDPR
PRIVACY_CONTROLLER=Gruppo di progetto SalesPilot (Politecnico di Torino)
PRIVACY_CONTACT_EMAIL=

# Alternativa senza Supabase: accesso condiviso, cronologia solo di sessione
SALESPILOT_USERNAME=nome_utente
SALESPILOT_PASSWORD=password_lunga_e_casuale
